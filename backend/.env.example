NODE_ENV=development
PORT=5000
# Leave empty in dev to use an in-memory MongoDB (not persisted)
MONGODB_URI=
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
BUSINESS_TZ=Asia/Kolkata
PAYMENT_TIMEOUT_MINUTES=15

# Initial owner (created once if no owner exists)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Encrypts payment secrets saved from the admin panel. REQUIRED in production; keep it stable (changing it invalidates saved secrets).
SETTINGS_ENCRYPTION_KEY=

# Razorpay: normally set in Admin -> Settings -> Payment gateway (owner only). These env vars are only a fallback default.
# https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ARAN <no-reply@aran.com>

# Web Push (optional): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@aran.com

# WhatsApp Business Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# SMS OTP (normally configured in Admin -> Settings -> SMS & OTP login; these are fallbacks)
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Address search: nominatim (default, free, light use) or google
GEO_PROVIDER=
GEO_CONTACT=support@aran.co
GOOGLE_MAPS_API_KEY=
